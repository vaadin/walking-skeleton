<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>flow</id>
    <formats>
        <format>zip</format>
    </formats>
    <fileSets>
        <fileSet>
            <outputDirectory>src/main/java</outputDirectory>
            <directory>${basedir}/target/generated-sources/flow</directory>
        </fileSet>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../walking-skeleton</directory>
            <includes>
                <include>src/**</include>
                <include>.gitignore</include>
                <include>LICENSE.md</include>
                <include>Dockerfile</include>
            </includes>
            <excludes>
                <exclude>src/main/bundles/**</exclude>
                <exclude>src/main/frontend/**</exclude>
                <exclude>src/main/resources/empty-application.properties</exclude>
                <exclude>src/main/resources/META-INF/resources/empty-styles.css</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../</directory>
            <includes>
                <include>.mvn/**</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${basedir}/../walking-skeleton/README-flow.md</source>
            <destName>README.md</destName>
        </file>
        <file>
            <source>${basedir}/target/nonempty-project/pom.xml</source>
        </file>
    </files>
</assembly>