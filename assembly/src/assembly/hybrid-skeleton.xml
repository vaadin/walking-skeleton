<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>hybrid</id>
    <formats>
        <format>zip</format>
    </formats>
    <fileSets>
        <fileSet>
            <outputDirectory>src/main/java</outputDirectory>
            <directory>${basedir}/target/generated-sources/hilla</directory>
            <excludes>
                <exclude>com/example/application/base/ui/view/MainLayout.java</exclude>
                <exclude>com/example/application/base/ui/view/MainView.java</exclude>
                <exclude>com/example/application/SecurityConfig.java</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../walking-skeleton</directory>
            <includes>
                <include>.mvn/**</include>
                <include>src/**</include>
                <include>.gitignore</include>
                <include>.prettierrc.json</include>
                <include>eclipse-formatter.xml</include>
                <include>LICENSE.md</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
                <include>pom.xml</include>
                <include>Dockerfile</include>
            </includes>
            <excludes>
                <exclude>src/main/frontend/generated/**</exclude>
                <exclude>src/main/frontend/themes/default/empty-styles.css</exclude>
                <exclude>src/main/frontend/index.html</exclude>
                <exclude>src/main/java/com/example/application/base/ui/view/MainLayout.java</exclude>
                <exclude>src/main/java/com/example/application/base/ui/view/MainView.java</exclude>
                <exclude>src/main/java/com/example/application/SecurityConfig.java</exclude>
            </excludes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${basedir}/../walking-skeleton/README-hybrid.md</source>
            <destName>README.md</destName>
        </file>
    </files>
</assembly>