<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>empty</id>
    <formats>
        <format>zip</format>
    </formats>
    <fileSets>
        <fileSet>
            <outputDirectory>src/main/java</outputDirectory>
            <directory>${basedir}/target/generated-sources/flow</directory>
            <includes>
                <include>com/example/application/Application.java</include>
                <include>com/example/application/SecurityConfig.java</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../walking-skeleton</directory>
            <includes>
                <include>.mvn/**</include>
                <include>src/**</include>
                <include>.gitignore</include>
                <include>.prettierrc.json</include>
                <include>eclipse-formatter.xml</include>
                <include>LICENSE.md</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
                <include>pom.xml</include>
                <include>Dockerfile</include>
            </includes>
            <excludes>
                <exclude>src/main/bundles/**</exclude>
                <exclude>src/main/frontend/generated/**</exclude>
                <exclude>src/main/frontend/components/**</exclude>
                <exclude>src/main/frontend/security/**</exclude>
                <!-- empty-styles.css will be included as styles.css (see below) -->
                <exclude>src/main/frontend/themes/default/*.css</exclude>
                <exclude>src/main/frontend/views/**</exclude>
                <exclude>src/main/frontend/index.html</exclude>
                <exclude>src/main/frontend/index.tsx</exclude>
                <exclude>src/main/java/**</exclude>
                <exclude>src/test/java/com/example/application/ArchitectureTest.java</exclude>
                <exclude>src/test/java/com/example/application/taskmanagement/**</exclude>
            </excludes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${basedir}/../walking-skeleton/src/main/frontend/themes/default/empty-styles.css</source>
            <destName>src/main/frontend/themes/default/styles.css</destName>
        </file>
        <file>
            <source>${basedir}/../walking-skeleton/README-empty.md</source>
            <destName>README.md</destName>
        </file>
    </files>
</assembly>