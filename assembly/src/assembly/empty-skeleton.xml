<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>empty</id>
    <formats>
        <format>zip</format>
    </formats>
    <fileSets>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../walking-skeleton</directory>
            <includes>
                <include>src/**</include>
                <include>.gitignore</include>
                <include>LICENSE.md</include>
                <include>Dockerfile</include>
            </includes>
            <excludes>
                <exclude>src/main/bundles/**</exclude>
                <exclude>src/main/frontend/**</exclude>
                <exclude>src/main/java/com/example/application/base/**</exclude>
                <exclude>src/main/java/com/example/application/examplefeature/**</exclude>
                <exclude>src/test/**</exclude>
                <exclude>src/main/resources/**</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <outputDirectory/>
            <directory>${basedir}/../</directory>
            <includes>
                <include>.mvn/**</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${basedir}/../walking-skeleton/README-empty.md</source>
            <destName>README.md</destName>
        </file>
        <file>
            <source>${basedir}/target/empty-project/pom.xml</source>
        </file>
        <file>
            <source>${basedir}/../walking-skeleton/src/main/resources/empty-application.properties</source>
            <destName>src/main/resources/application.properties</destName>
        </file>
        <file>
            <source>${basedir}/../walking-skeleton/src/main/resources/META-INF/resources/empty-styles.css</source>
            <destName>src/main/resources/META-INF/resources/styles.css</destName>
        </file>
    </files>
</assembly>